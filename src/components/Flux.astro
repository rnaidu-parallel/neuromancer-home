---
/**
 * Flux.astro — the living background. Mounted once in Base, behind (grid/glow/
 * shader) and in front of (CRT pass) the page content. Adapted from the blog's
 * terminal grid + CRT treatment, retuned to amber-on-near-black.
 *
 * Owns the whole background stack, including the pointer-reactive WebGL
 * membrane (FluxShader.astro). The shader self-gates (non-reduced + fine
 * pointer + desktop width + WebGL available); when it goes live it adds
 * `.has-shader` here, which suppresses the two CSS glow blobs (redundant under
 * the shader) while the grid drift + CRT pass stay layered over it. When the
 * shader never starts, the CSS layers below are the complete fallback.
 *
 * Every layer is aria-hidden, pointer-events:none, position:fixed — zero layout
 * impact, invisible to AT. Only transform (grid drift, sweep) and opacity (glow
 * breathe) are ever animated. Under prefers-reduced-motion: reduce all motion is
 * off but the static texture (grid, scanlines, vignette, glows) stays.
 *
 * Stacking (see tokens --z-*): grid + glows at z-index 0 (behind #main, which is
 * z-index 1); CRT pass at z-index 5 (a whisper OVER the content, like the blog),
 * below nav (100) and cursor (200).
 */
import FluxShader from './FluxShader.astro';
---

<div class="flux" aria-hidden="true">
  <FluxShader />
  <div class="flux-grid"></div>
  <div class="flux-glow flux-glow-1"></div>
  <div class="flux-glow flux-glow-2"></div>
  <div class="flux-crt"></div>
</div>

<style>
  /* Grid layer — accent-tinted hairline lattice, 34px cells, fading out by ~75%
     down the viewport. Sized 200vw × 200vh so it can drift diagonally by a few
     whole cells without ever exposing an edge. */
  .flux-grid {
    position: fixed;
    top: 0;
    left: 0;
    width: 200vw;
    height: 200vh;
    pointer-events: none;
    z-index: 0;
    background-image: linear-gradient(var(--grid-line) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid-line) 1px, transparent 1px);
    background-size: 34px 34px;
    /* vh stops keep the fade viewport-anchored even though the box is 200vh; the
       few-px drift shifts it imperceptibly. */
    mask-image: linear-gradient(to bottom, #000 0, #000 30vh, transparent 75vh);
    -webkit-mask-image: linear-gradient(to bottom, #000 0, #000 30vh, transparent 75vh);
    will-change: transform;
  }

  /* Phosphor glow — soft radial blobs so the black reads lit, not flat. Amber
     upper-left (under the hero name); cyan lower-right, opposite breathing
     phase. */
  .flux-glow {
    position: fixed;
    pointer-events: none;
    z-index: 0;
    opacity: 0.6;
    will-change: opacity;
  }

  .flux-glow-1 {
    top: 8%;
    left: 4%;
    width: 700px;
    height: 560px;
    background: radial-gradient(ellipse at center, var(--glow) 0, transparent 70%);
  }

  /* Shader live: the WebGL membrane replaces the static glow blobs. Grid and
     CRT pass stay — they read as the screen the membrane lives behind. */
  .flux.has-shader .flux-glow {
    display: none;
  }

  .flux-glow-2 {
    bottom: 6%;
    right: 4%;
    width: 520px;
    height: 420px;
    background: radial-gradient(
      ellipse at center,
      rgba(127, 212, 228, 0.04) 0,
      transparent 70%
    );
  }

  /* CRT pass — scanlines + edge vignette OVER the content at whisper opacity,
     plus a slow sweep band (the ::after). */
  .flux-crt {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 5;
    background: repeating-linear-gradient(
        to bottom,
        var(--scanline) 0 1px,
        transparent 1px 4px
      ),
      radial-gradient(ellipse 160% 110% at 50% 35%, transparent 60%, var(--vignette) 100%);
  }

  .flux-crt::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 22vh;
    background: linear-gradient(to bottom, transparent, var(--sweep) 50%, transparent);
    /* Static rest position: parked off the top, invisible. Only animated under
       no-preference (below). */
    transform: translateY(-25vh);
    will-change: transform;
  }

  /* Motion is opt-in: nothing animates under reduce; the static grid, glows,
     scanlines and vignette carry the texture on their own. */
  @media (prefers-reduced-motion: no-preference) {
    .flux-grid {
      animation: flux-drift 70s linear infinite;
    }
    .flux-glow {
      animation: flux-breathe 9s ease-in-out infinite alternate;
    }
    .flux-glow-2 {
      animation-delay: -4.5s;
    }
    .flux-crt::after {
      animation: flux-sweep 11s linear infinite;
    }
  }

  /* Diagonal drift by exactly 3 cells across, 2 down (102 = 3·34, 68 = 2·34) so
     the lattice loops seamlessly. */
  @keyframes flux-drift {
    from {
      transform: translate(0, 0);
    }
    to {
      transform: translate(-102px, -68px);
    }
  }

  @keyframes flux-breathe {
    from {
      opacity: 0.6;
    }
    to {
      opacity: 1;
    }
  }

  /* One band sweeps down (reaching the bottom at 35%), then the screen rests. */
  @keyframes flux-sweep {
    0% {
      transform: translateY(-25vh);
    }
    35% {
      transform: translateY(125vh);
    }
    100% {
      transform: translateY(125vh);
    }
  }
</style>
