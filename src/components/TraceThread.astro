---
/**
 * TraceThread.astro — one rail segment for a single span.
 *
 * Not a full-page path: each span owns this segment inside its rail column, so
 * resize / content changes never force a global path recalculation.
 *
 * Final-state DOM = fully drawn: the amber draw line covers the grey guide and
 * the marker is filled amber. thread.ts (non-reduced) applies the undrawn
 * pre-state (`.is-idle` marker, scaleY(0) line, dashed-out elbow) at runtime,
 * then scrubs on scroll. With JS off, or under reduced motion, the segment
 * stays drawn.
 *
 * Geometry:
 *  - .thread-guide-v / .thread-draw-v : 2px vertical rules extended ±--span-pad
 *    so adjacent segments touch, forming one continuous thread down the page.
 *    IDENTICAL geometry for guide and draw — the amber line covers the seam
 *    region end-to-end once drawn. The draw rule animates via scaleY
 *    (transform-origin top), not stroke-dash: the rail is stretched
 *    per-section, and dash patterns under non-scaling-stroke render
 *    inconsistently across browsers; scaleY on a solid rule is exact and
 *    resize-stable.
 *  - .thread-elbow : branch spans only — fixed-aspect SVG (dash math exact),
 *    the tool call peeling off into content.
 *  - .thread-marker: fixed-size dot aligned to the span header row.
 *  - terminal (answer span): the rules stop at the rail's bottom — no thread
 *    beside or below the footer, the run is over — and a small amber cap
 *    closes the line at its endpoint.
 */
interface Props {
  branch?: boolean;
  terminal?: boolean;
}
const { branch = false, terminal = false } = Astro.props;
const elbow = 'M6 2 V13 Q6 22 15 22 H46';
---

<div class:list={['thread', { 'is-terminal': terminal }]} aria-hidden="true">
  <div class="thread-guide-v"></div>
  <div class="thread-draw-v" data-thread-v></div>

  {
    branch && (
      <svg class="thread-elbow" viewBox="0 0 48 28" width="48" height="28">
        <path class="thread-guide" d={elbow} fill="none" />
        <path class="thread-draw" d={elbow} fill="none" data-thread-draw />
      </svg>
    )
  }

  <svg class="thread-marker" viewBox="0 0 16 16" width="16" height="16">
    <circle cx="8" cy="8" r="5"></circle>
  </svg>

  {
    terminal && (
      <svg class="thread-cap" data-thread-cap viewBox="0 0 8 8" width="8" height="8">
        <rect x="1" y="1" width="6" height="6"></rect>
      </svg>
    )
  }
</div>

<style>
  .thread {
    position: absolute;
    inset: 0;
    overflow: visible;
    z-index: var(--z-thread);
  }

  /* Vertical rules: identical geometry for guide and draw, extended ±pad to
     bridge the sections' padding-block so adjacent segments touch. */
  .thread-guide-v,
  .thread-draw-v {
    position: absolute;
    left: 50%;
    top: calc(-1 * var(--span-pad));
    bottom: calc(-1 * var(--span-pad));
    width: 2px;
    margin-left: -1px;
  }

  .thread-guide-v {
    background: var(--c-line);
  }

  /* Amber overlay — undrawn state (scaleY 0) is applied by thread.ts. The
     default (no-JS / reduced) state is fully drawn. */
  .thread-draw-v {
    background: var(--c-amber);
    transform-origin: 50% 0;
  }

  /* Terminal segment: the thread ends at the rail's bottom — the run is over,
     no line beside or below the footer. */
  .is-terminal .thread-guide-v,
  .is-terminal .thread-draw-v {
    bottom: 0;
  }

  .thread-guide {
    stroke: var(--c-line);
    stroke-width: 2;
  }

  .thread-draw {
    stroke: var(--c-amber);
    stroke-width: 2;
    stroke-linecap: round;
  }

  .thread-elbow {
    position: absolute;
    left: calc(50% - 6px);
    top: calc(var(--head-center) - 2px);
    overflow: visible;
  }

  /* Marker: filled amber by default (drawn). thread.ts adds .is-idle for the
     pre-run grey state, then removes it when the span is reached. */
  .thread-marker {
    position: absolute;
    left: 50%;
    top: var(--head-center);
    transform: translate(-50%, -50%);
    overflow: visible;
    filter: drop-shadow(0 0 6px var(--c-amber-dim));
    transition: filter var(--dur-fast) var(--ease-out);
  }

  .thread-marker circle {
    fill: var(--c-amber);
    stroke: var(--c-amber);
    stroke-width: 2;
    transition:
      fill var(--dur-fast) var(--ease-out),
      stroke var(--dur-fast) var(--ease-out);
  }

  .thread-marker.is-idle {
    filter: none;
  }

  .thread-marker.is-idle circle {
    fill: var(--c-bg);
    stroke: var(--c-line);
  }

  /* Terminal cap: a small amber square closing the thread at its endpoint.
     Idle (grey) until the final segment finishes drawing. */
  .thread-cap {
    position: absolute;
    left: 50%;
    bottom: 0;
    transform: translate(-50%, 50%);
    overflow: visible;
  }

  .thread-cap rect {
    fill: var(--c-amber);
    transition: fill var(--dur-fast) var(--ease-out);
  }

  .thread-cap.is-idle rect {
    fill: var(--c-line);
  }

  @media (max-width: 767px) {
    /* smaller marker on mobile; branch elbows hidden */
    .thread-marker {
      transform: translate(-50%, -50%) scale(0.8);
    }
    .thread-elbow {
      display: none;
    }
  }
</style>
