---
/**
 * EvalBoard.astro — span 05 (eval: scoreboard) content.
 *
 * A real <table> styled as eval-harness output: every published claim checked
 * against its number, with a `source` column pointing back to the span that
 * makes the claim. Values are VERBATIM — the numbers audit greps for them.
 *
 * Final-state DOM: the exact final string is the HTML source of truth for every
 * result cell. The inline script counts each number up from 0 on enter, then
 * restores the captured string exactly (non-reduced branch only). With JS off /
 * reduced motion the table is static with final numbers shown.
 */
interface CountPart {
  to: number;
  dec: number;
}
interface Row {
  metric: string;
  result: string;
  source: string;
  href: string;
  count: { tpl: string; parts: CountPart[] };
}

const rows: Row[] = [
  {
    metric: '2h-ahead glucose predictions in Clarke Zone A',
    result: '94%',
    source: 'get_experience → 03',
    href: '#experience',
    count: { tpl: '{0}%', parts: [{ to: 94, dec: 0 }] },
  },
  {
    metric: 'vision meal-logging throughput',
    result: '10k+ images/day',
    source: 'get_experience → 03',
    href: '#experience',
    count: { tpl: '{0}k+ images/day', parts: [{ to: 10, dec: 0 }] },
  },
  {
    metric: 'meal-logging adoption after ship',
    result: '24% → 38%',
    source: 'get_experience → 03',
    href: '#experience',
    count: { tpl: '{0}% → {1}%', parts: [{ to: 24, dec: 0 }, { to: 38, dec: 0 }] },
  },
  {
    metric: 'local agent generation speed, 6GB VRAM',
    result: '44.3 tok/s',
    source: 'get_projects → 02',
    href: '#projects',
    count: { tpl: '{0} tok/s', parts: [{ to: 44.3, dec: 1 }] },
  },
  {
    metric: 'input cost after moving one timestamp',
    result: '−82%',
    source: 'get_projects → 02',
    href: '#projects',
    count: { tpl: '−{0}%', parts: [{ to: 82, dec: 0 }] },
  },
];
---

<p class="lede">Claims are cheap. Checking the published numbers:</p>

<div class="eval-wrap" data-wide>
  <table class="eval mono" data-eval>
    <thead>
      <tr>
        <th scope="col" class="eval-h-metric">metric</th>
        <th scope="col" class="eval-h-result">result</th>
        <th scope="col" class="eval-h-source">source</th>
      </tr>
    </thead>
    <tbody>
      {
        rows.map((r) => (
          <tr>
            <th scope="row" class="eval-metric">
              {r.metric}
            </th>
            <td class="eval-result" data-count={JSON.stringify(r.count)}>
              {r.result}
            </td>
            <td class="eval-source">
              <a href={r.href}>{r.source}</a>
            </td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

<p class="eval-pass mono">[5/5 checks passed]</p>

<style>
  .lede {
    color: var(--c-text);
    font-size: var(--fs-h3);
    line-height: 1.4;
  }

  .eval-wrap {
    margin-top: var(--sp-6);
    overflow-x: auto;
  }

  .eval {
    border-collapse: collapse;
    font-size: var(--fs-micro);
    width: 100%;
  }

  .eval th,
  .eval td {
    text-align: left;
    padding: var(--sp-2) var(--sp-6) var(--sp-2) 0;
    border-top: 1px solid var(--c-line);
    vertical-align: top;
  }

  .eval thead th {
    color: var(--c-text);
    opacity: 0.7;
    font-weight: 400;
    border-top: 0;
    border-bottom: 1px solid var(--c-line);
  }

  .eval-metric {
    color: var(--c-bright);
    font-weight: 400;
  }

  .eval-result {
    color: var(--c-amber);
    font-weight: 700;
    white-space: nowrap;
  }

  .eval-source {
    padding-right: 0;
    white-space: nowrap;
  }
  .eval-source a {
    color: var(--c-cyan);
  }

  .eval-pass {
    margin-top: var(--sp-4);
    color: var(--c-ok);
  }
</style>

<script>
  // Count-up on enter — final numbers are the HTML source of truth; capture,
  // animate toward, restore exactly. Runtime-only, non-reduced branch.
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { onMotionReady } from '../scripts/motion';

  interface CountPart {
    to: number;
    dec: number;
  }
  interface CountSpec {
    tpl: string;
    parts: CountPart[];
  }

  onMotionReady(({ reduced }) => {
    if (reduced) return;
    const table = document.querySelector<HTMLElement>('[data-eval]');
    if (!table) return;

    const cells = Array.from(table.querySelectorAll<HTMLElement>('[data-count]'));
    if (!cells.length) return;

    const specs = cells.map((cell) => {
      const original = cell.textContent ?? '';
      let spec: CountSpec | null = null;
      try {
        spec = JSON.parse(cell.getAttribute('data-count') ?? 'null') as CountSpec | null;
      } catch {
        spec = null;
      }
      return { cell, original, spec };
    });

    const render = (p: number): void => {
      for (const { cell, spec } of specs) {
        if (!spec) continue;
        cell.textContent = spec.tpl.replace(/\{(\d+)\}/g, (_m, i: string) => {
          const part = spec.parts[Number(i)];
          if (!part) return '';
          const v = part.to * p;
          return part.dec ? v.toFixed(part.dec) : String(Math.round(v));
        });
      }
    };

    const proxy = { p: 0 };
    ScrollTrigger.create({
      trigger: table,
      start: 'top 80%',
      once: true,
      onEnter: () => {
        specs.forEach(({ cell, original }) => cell.setAttribute('aria-label', original));
        render(0);
        gsap.to(proxy, {
          p: 1,
          duration: 1,
          ease: 'power1.out',
          onUpdate: () => render(proxy.p),
          onComplete: () => {
            specs.forEach(({ cell, original }) => {
              cell.textContent = original;
              cell.removeAttribute('aria-label');
            });
          },
        });
      },
    });
  });
</script>
