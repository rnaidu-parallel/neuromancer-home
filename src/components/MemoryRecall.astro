---
/**
 * MemoryRecall.astro — span 04 (memory: recall("writing")) content.
 *
 * Data resolves at BUILD time via getWriting() (live RSS + committed fallback,
 * see data/writing.ts). Each hit is a row: `hit` glyph + recency score + the
 * post title (link) + date. The relevance score is honestly just recency, and
 * the footnote says so.
 *
 * Final-state DOM: every hit ships as real text/links. The inline script only
 * applies a hidden pre-state + enter stagger at runtime in the non-reduced
 * branch; with JS off / reduced motion the list is static and fully visible.
 */
import { getWriting } from '../data/writing';

const hits = await getWriting();
---

<div class="mr" data-mr>
  <p class="mr-intro mono">
    recall("writing") → {hits.length} hits from blog.neuromancer.in
  </p>

  <ul class="mr-list">
    {
      hits.map((h) => (
        <li class="mr-hit" data-mr-item>
          <span class="mr-glyph mono" aria-hidden="true">
            hit
          </span>
          <span class="mr-score mono">{h.score.toFixed(2)}</span>
          <a class="mr-title" href={h.url}>
            {h.title}
          </a>
          <span class="mr-date mono">{h.date}</span>
        </li>
      ))
    }
  </ul>

  <p class="mr-note mono">relevance here is just recency. read them and score for yourself.</p>
</div>

<style>
  .mr {
    display: flex;
    flex-direction: column;
    gap: var(--sp-6);
  }

  .mr-intro {
    color: var(--c-cyan);
  }

  .mr-list {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
  }

  /* score · title · date; glyph + score are the fixed-width mono rail. */
  .mr-hit {
    display: grid;
    grid-template-columns: auto auto 1fr auto;
    gap: var(--sp-3);
    align-items: baseline;
  }

  .mr-glyph {
    color: var(--c-cyan);
    user-select: none;
  }
  .mr-score {
    color: var(--c-amber);
  }

  .mr-title {
    font-family: var(--font-sans);
    font-size: var(--fs-body);
    color: var(--c-bright);
    text-decoration: none;
    line-height: 1.4;
  }
  .mr-title:hover {
    color: var(--c-bright);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .mr-date {
    color: var(--c-text);
    white-space: nowrap;
  }

  .mr-note {
    color: var(--c-text);
  }

  @media (max-width: 767px) {
    /* date drops to its own line under the title on narrow widths */
    .mr-hit {
      grid-template-columns: auto auto 1fr;
    }
    .mr-date {
      grid-column: 2 / -1;
    }
  }
</style>

<script>
  // Enter stagger — final-state DOM, runtime-only pre-state, non-reduced branch.
  import gsap from 'gsap';
  import { onMotionReady } from '../scripts/motion';

  // ScrollTrigger is registered globally by motion.ts; the shared gsap instance
  // resolves the `scrollTrigger:` config below, so no direct import is needed.
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  onMotionReady(({ reduced }) => {
    if (reduced) return;
    const root = document.querySelector<HTMLElement>('[data-mr]');
    if (!root) return;
    const items = gsap.utils.toArray<HTMLElement>('[data-mr-item]', root);
    if (!items.length) return;

    gsap.from(items, {
      opacity: 0,
      y: 16,
      duration: 0.5,
      ease: 'power2.out',
      stagger: 0.08,
      scrollTrigger: { trigger: root, start: 'top 80%', once: true },
    });

    // Score count-up — the final "0.NN" strings are the HTML source of truth;
    // capture, pin the accessible name, count from 0 on enter, restore exactly
    // (same pattern as EvalBoard's count-up).
    const scores = Array.from(root.querySelectorAll<HTMLElement>('.mr-score'));
    if (!scores.length) return;
    const finals = scores.map((s) => s.textContent ?? '');
    ScrollTrigger.create({
      trigger: root,
      start: 'top 80%',
      once: true,
      onEnter: () => {
        scores.forEach((s, i) => {
          const final = finals[i]!;
          const to = parseFloat(final) || 0;
          s.setAttribute('aria-label', final);
          const proxy = { v: 0 };
          gsap.to(proxy, {
            v: to,
            duration: 0.6,
            delay: i * 0.08,
            ease: 'power1.out',
            onUpdate: () => {
              s.textContent = proxy.v.toFixed(2);
            },
            onComplete: () => {
              s.textContent = final;
              s.removeAttribute('aria-label');
            },
          });
        });
      },
    });
  });
</script>
