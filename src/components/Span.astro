---
/**
 * Span.astro — section wrapper for the six trace spans.
 *
 * Two-column grid: a left rail (the thread segment) + the content column. The
 * span header IS the visible <h2> (document outline = span kinds); the dot and
 * index are aria-hidden decoration, so the accessible heading name is just the
 * `kind` (e.g. "plan", "tool_call: get_projects()").
 *
 * Content column is full-width (not clamped) so later-phase wide elements can
 * break out via a [data-wide] child; ordinary text blocks clamp to --w-prose.
 */
import TraceThread from './TraceThread.astro';

interface Props {
  id: string;
  index: string; // e.g. "01"
  kind: string; // the real, accessible label
  branch?: boolean;
  terminal?: boolean; // last span: the thread ends here (cap, no extension below)
}
const { id, index, kind, branch = false, terminal = false } = Astro.props;
---

<section id={id} class="span" data-span aria-labelledby={`${id}-h`}>
  <div class="span-rail">
    <TraceThread branch={branch} terminal={terminal} />
  </div>

  <div class="span-content" data-span-content>
    <h2 id={`${id}-h`} class="span-head mono">
      <span class="span-dot" aria-hidden="true">●</span>
      <span class="span-index" aria-hidden="true"> {index} · </span>
      <span class="span-kind">{kind}</span>
    </h2>

    <div class="span-body">
      <slot />
    </div>
  </div>
</section>

<style>
  .span {
    --span-pad: var(--sp-24);
    --head-center: 0.62rem;
    position: relative;
    display: grid;
    grid-template-columns: var(--rail) minmax(0, 1fr);
    column-gap: var(--sp-2);
    padding-block: var(--span-pad);
    scroll-margin-top: var(--sp-12);
  }

  .span-rail {
    position: relative;
  }

  .span-content {
    position: relative;
    z-index: var(--z-content);
    min-width: 0;
  }

  /* The header line is the visible heading, styled as a mono terminal line. */
  .span-head {
    font-size: var(--fs-micro);
    line-height: 1.5;
    font-weight: 400;
    margin-bottom: var(--sp-6);
  }

  .span-index {
    color: var(--c-dim); /* decorative, aria-hidden */
  }

  .span-dot {
    color: var(--c-amber); /* decorative echo of the rail marker */
  }

  .span-kind {
    color: var(--c-amber); /* the real label */
  }

  /* Clamp text blocks to the reading column; [data-wide] children break out.
     :global is required because slotted children carry the parent page's
     scope, not this component's. */
  .span-body > :global(*) {
    max-width: var(--w-prose);
  }
  .span-body > :global([data-wide]) {
    max-width: none;
  }

  @media (max-width: 767px) {
    .span {
      --span-pad: var(--sp-16);
      --head-center: 0.58rem;
      grid-template-columns: var(--rail-m) minmax(0, 1fr);
    }
  }
</style>
