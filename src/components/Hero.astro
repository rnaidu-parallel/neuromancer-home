---
/**
 * Hero.astro — Phase 1 boot sequence.
 *
 * Final-state DOM: every string below ships as real text in the HTML. With JS
 * off (or before boot.ts runs) the whole hero is fully visible and readable —
 * boot.ts applies pre-boot hidden states at runtime, never CSS. Only
 * transform / opacity are animated.
 */

// trace_id: 8-char hex, hashed from the build timestamp — one deterministic
// value per build (FNV-1a over the ISO stamp, computed once here at build time).
const buildStamp = new Date().toISOString();
let h = 0x811c9dc5;
for (const ch of buildStamp) {
  h ^= ch.charCodeAt(0);
  h = Math.imul(h, 0x01000193);
}
const traceId = (h >>> 0).toString(16).padStart(8, '0');
---

<header id="boot" class="hero">
  <div class="hero-body">
    <p class="mono hero-query" data-boot="query">
      <span class="hero-prompt">$</span><span data-type-line> query "who is rahul?"</span>
    </p>

    <p class="mono hero-run" data-boot="run">
      <span class="hero-ok">[run started]</span> trace_id: {traceId} · spans: 6
    </p>

    <h1 class="hero-name">
      <span data-boot="name">Rahul Naidu Siriporam</span><span
        class="hero-caret"
        aria-hidden="true">▋</span>
    </h1>

    <p class="hero-headline" data-boot="headline">
      Founding engineer at Canvas AI. I build agentic AI systems and run them in
      production: memory architectures, eval harnesses, tool calling that
      survives model swaps.
    </p>

    <p class="mono hero-status" data-boot="status">
      <span class="hero-cyan">[status]</span> open to agentic AI roles · remote · IST
    </p>
  </div>

  <p class="mono hero-cue" data-boot="cue">
    scroll to trace <span class="hero-arrow" aria-hidden="true">↓</span>
  </p>
</header>

<style>
  .hero {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    position: relative;
    padding-block: var(--sp-16);
  }

  .hero-body {
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
    max-width: var(--w-prose);
  }

  /* mono lines carry the terminal colouring; base stays --c-text (NOT --c-dim) */
  .hero-query,
  .hero-run {
    color: var(--c-text);
  }
  .hero-query {
    color: var(--c-bright);
  }
  .hero-prompt {
    color: var(--c-amber);
  }
  .hero-ok {
    color: var(--c-ok);
  }
  .hero-cyan {
    color: var(--c-cyan);
  }

  .hero-name {
    font-family: var(--font-sans);
    font-size: var(--fs-display);
    line-height: var(--lh-tight);
    font-weight: 600;
    color: var(--c-bright);
    margin-block: var(--sp-2);
  }

  .hero-headline {
    font-family: var(--font-sans);
    font-size: var(--fs-h3);
    line-height: 1.4;
    color: var(--c-text);
    max-width: var(--w-prose);
  }

  .hero-status {
    color: var(--c-text);
  }

  .hero-cue {
    position: absolute;
    left: 0;
    bottom: var(--sp-8);
    color: var(--c-text);
    display: flex;
    align-items: center;
    gap: var(--sp-2);
  }

  .hero-arrow {
    display: inline-block;
    color: var(--c-amber);
  }

  /* amber block caret after the name — the run's cursor, resting where the
     scramble ends. Steady 1s blink; decorative, aria-hidden. */
  .hero-caret {
    color: var(--c-amber);
    margin-left: 0.08em;
    font-size: 0.75em;
    font-weight: 400;
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero-caret {
      animation: hero-blink 1.1s steps(2, jump-none) infinite;
    }
  }

  @keyframes hero-blink {
    0% {
      opacity: 1;
    }
    100% {
      opacity: 0;
    }
  }

  /* Decorative 6px y-bob on the arrow only; gated behind reduced-motion. */
  @media (prefers-reduced-motion: no-preference) {
    .hero-arrow {
      animation: hero-bob 1.6s var(--ease-out) infinite;
    }
  }

  @keyframes hero-bob {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(6px);
    }
  }
</style>
