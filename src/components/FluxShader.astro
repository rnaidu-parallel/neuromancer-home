---
/**
 * FluxShader.astro — the pointer-reactive membrane behind the page.
 *
 * Adapted from the blog's Blackwall shader (rnaidu-parallel/neuromancer-blog,
 * BlackwallHero.astro): a domain-warped fbm field laced with fracture veins
 * that flare toward the cursor. Re-voiced for TRACE — amber veins on the
 * #070a12 near-black, at a lower intensity than the blog because this runs
 * under a whole page of text, not just a hero.
 *
 * Progressive enhancement, hard-gated. The canvas + rAF loop are created ONLY
 * when: non-reduced motion AND fine pointer AND viewport ≥ 768px AND a WebGL
 * context is actually obtained. In every other case this component contributes
 * nothing at runtime and the CSS Flux layers (grid/glow/CRT) remain the
 * complete background. When the shader IS live, the two CSS glow blobs are
 * suppressed (redundant under the shader) but the grid drift + CRT pass stay
 * layered over it.
 *
 * Uniforms kept from the blog: u_mouse/u_press (cursor heat, eased for the
 * heavy fluid feel), u_calm (veins fade to a whisper one viewport down — this
 * is what protects readability on a fixed full-page canvas), u_burst/u_burstO
 * (shockwave). Dropped: u_reveal (blog's typewriter coupling).
 *
 * Bursts — exactly two, the moments that deserve drama:
 *   - `trace:boot-complete` (dispatched by boot.ts when the hero name
 *     resolves, on BOTH boot paths) → full burst from the name's center.
 *   - a click on the MCP copy-config button → half burst from the button.
 */
---

<script>
  import { onMotionReady } from '../scripts/motion';

  // The canvas is created HERE at runtime, only once every gate passes — so the
  // served HTML (and any reduced-motion / mobile / no-WebGL session) contains no
  // <canvas> at all and the CSS Flux layers are the complete background.
  onMotionReady(({ reduced, desktop }) => {
    if (reduced || !desktop) return;
    if (!window.matchMedia('(pointer: fine)').matches) return;
    const host = document.querySelector<HTMLElement>('.flux');
    if (!host) return;

    const canvas = document.createElement('canvas');
    canvas.className = 'flux-shader';
    canvas.setAttribute('aria-hidden', 'true');
    const gl = canvas.getContext('webgl', {
      antialias: false,
      alpha: true,
      premultipliedAlpha: false,
    });
    if (!gl) return; // no WebGL -> canvas never enters the DOM, CSS fallback stays
    host.prepend(canvas); // first child: under the grid, glows, CRT pass
    init(canvas, gl);
  });

  function init(canvas: HTMLCanvasElement, gl: WebGLRenderingContext): void {
    const VERT = `
      attribute vec2 a_pos;
      void main() { gl_Position = vec4(a_pos, 0.0, 1.0); }
    `;

    // Domain-warped fbm membrane + amber fracture veins + cursor heat.
    const FRAG = `
      precision highp float;
      uniform float u_time;
      uniform vec2  u_res;
      uniform vec2  u_mouse;   // 0..1, y up
      uniform float u_intro;   // 0..1 fade-in ramp
      uniform float u_press;   // 0..1 cursor proximity energy
      uniform float u_calm;    // 0 at the top -> 1 scrolled into content
      uniform float u_burst;   // 1 on an action (boot lands / config copied), decays
      uniform vec2  u_burstO;  // 0..1 origin the burst emanates from

      float hash(vec2 p){
        p = fract(p * vec2(123.34, 345.45));
        p += dot(p, p + 34.345);
        return fract(p.x * p.y);
      }
      float noise(vec2 p){
        vec2 i = floor(p); vec2 f = fract(p);
        vec2 u = f * f * (3.0 - 2.0 * f);
        float a = hash(i);
        float b = hash(i + vec2(1.0, 0.0));
        float c = hash(i + vec2(0.0, 1.0));
        float d = hash(i + vec2(1.0, 1.0));
        return mix(mix(a, b, u.x), mix(c, d, u.x), u.y);
      }
      float fbm(vec2 p){
        float v = 0.0, a = 0.5;
        mat2 m = mat2(1.6, 1.2, -1.2, 1.6);
        for (int i = 0; i < 5; i++) { v += a * noise(p); p = m * p; a *= 0.5; }
        return v;
      }

      void main(){
        vec2 uv = gl_FragCoord.xy / u_res.xy;
        vec2 p  = uv;
        p.x *= u_res.x / u_res.y;            // aspect-correct
        float t = u_time * 0.04 + u_burst * 0.35;  // bursts churn the field

        // two-step domain warp -> turbulent membrane
        vec2 q = vec2(fbm(p * 2.6 + vec2(0.0, t)),
                      fbm(p * 2.6 + vec2(5.2, 1.3) - t));
        vec2 r = vec2(fbm(p * 2.6 + 2.0 * q + vec2(1.7, 9.2) + t * 0.5),
                      fbm(p * 2.6 + 2.0 * q + vec2(8.3, 2.8)));
        float f = fbm(p * 2.6 + 3.4 * r);

        // cursor heat — the field pressed from the other side
        vec2 m = u_mouse; m.x *= u_res.x / u_res.y;
        float heat = exp(-distance(p, m) * 3.2) * u_press;
        f += heat * 0.30;

        vec3 bg  = vec3(0.027, 0.039, 0.071);   // #070a12 = --c-bg
        vec3 col = bg;

        // fade the veins back as the reader scrolls into content — on a fixed
        // full-page canvas this calm fade is what protects the body text
        float vis = mix(1.0, 0.22, u_calm);

        // cyan-tinted sheen in the deeper folds (data glow, not steel)
        col += vec3(0.031, 0.052, 0.056) * smoothstep(0.25, 0.95, f);

        // low-frequency zoning: large calm stretches between active regions,
        // so the veins read as sparse cracks, not lava
        float zone = smoothstep(0.30, 0.62, fbm(p * 0.85 + vec2(t * 0.3, -t * 0.2)));
        float charge = mix(0.18, 1.0, zone);

        // fracture veins: a thin bright ridge where the field crosses 0.5.
        // Lower base intensity than the blog — this runs under body text.
        float vein  = abs(f - 0.5);
        float crack = smoothstep(0.040, 0.0, vein);
        vec3  accent = vec3(1.0, 0.706, 0.329);  // #ffb454 = --c-amber
        col += accent * crack * charge * (0.16 + heat * 0.9) * vis;
        col += accent * smoothstep(0.12, 0.0, vein) * charge * 0.020 * vis;

        // action burst — a shockwave ring + flare erupting from the origin.
        // Ignores the calm fade so an action always reads, even mid-page.
        if (u_burst > 0.001) {
          vec2 bo = u_burstO; bo.x *= u_res.x / u_res.y;
          float bd     = distance(p, bo);
          float radius = (1.0 - u_burst) * 1.6;                 // ring expands as it decays
          float ring   = smoothstep(0.14, 0.0, abs(bd - radius)) * u_burst;
          col += accent * ring * 1.6;                           // the shockwave
          col += accent * exp(-bd * 2.2) * u_burst * 0.8;       // core flare
          col += accent * crack * charge * u_burst * 1.1;       // veins blaze
          col += accent * u_burst * u_burst * 0.05;             // faint field wash
        }

        // CRT echo + edge vignette so the canvas melts into the page
        col *= 0.93 + 0.07 * sin(gl_FragCoord.y * 0.7);
        float vig = smoothstep(1.15, 0.15, length(uv - 0.5));
        col = mix(bg, col, vig);

        gl_FragColor = vec4(col, vig * u_intro);
      }
    `;

    const compile = (type: number, src: string): WebGLShader => {
      const s = gl.createShader(type)!;
      gl.shaderSource(s, src);
      gl.compileShader(s);
      return s;
    };
    const prog = gl.createProgram()!;
    gl.attachShader(prog, compile(gl.VERTEX_SHADER, VERT));
    gl.attachShader(prog, compile(gl.FRAGMENT_SHADER, FRAG));
    gl.linkProgram(prog);
    if (!gl.getProgramParameter(prog, gl.LINK_STATUS)) {
      canvas.remove(); // bail -> CSS fallback stays, no dead canvas left behind
      return;
    }
    gl.useProgram(prog);

    const buf = gl.createBuffer();
    gl.bindBuffer(gl.ARRAY_BUFFER, buf);
    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
    const loc = gl.getAttribLocation(prog, 'a_pos');
    gl.enableVertexAttribArray(loc);
    gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0);

    const u = {
      time: gl.getUniformLocation(prog, 'u_time'),
      res: gl.getUniformLocation(prog, 'u_res'),
      mouse: gl.getUniformLocation(prog, 'u_mouse'),
      intro: gl.getUniformLocation(prog, 'u_intro'),
      press: gl.getUniformLocation(prog, 'u_press'),
      calm: gl.getUniformLocation(prog, 'u_calm'),
      burst: gl.getUniformLocation(prog, 'u_burst'),
      burstO: gl.getUniformLocation(prog, 'u_burstO'),
    };

    // Shader is live: suppress the redundant CSS glow blobs; grid + CRT stay.
    canvas.closest('.flux')?.classList.add('has-shader');
    canvas.classList.add('is-live');

    // --- bursts: exactly two hooks ---------------------------------------
    // Normalize a client-rect center to shader coords (0..1, y up).
    const originOf = (el: Element | null): { x: number; y: number } => {
      if (!el) return { x: 0.5, y: 0.55 };
      const r = el.getBoundingClientRect();
      return {
        x: (r.left + r.width / 2) / window.innerWidth,
        y: 1 - (r.top + r.height / 2) / window.innerHeight,
      };
    };

    let burst = 0;
    let bx = 0.5;
    let by = 0.55;
    const fire = (strength: number, origin: { x: number; y: number }): void => {
      bx = origin.x;
      by = origin.y;
      burst = Math.max(burst, strength);
      loop();
    };

    // 1) boot lands: full burst from the hero name.
    window.addEventListener('trace:boot-complete', () => {
      fire(1, originOf(document.querySelector('[data-boot="name"]')));
    });

    // 2) config copied: half burst from the button.
    document.querySelector('[data-mcp-copy]')?.addEventListener('click', (e) => {
      fire(0.5, originOf(e.currentTarget as Element));
    });

    // --- pointer state (eased toward the target for the heavy fluid feel) ---
    let mx = 0.5,
      my = 0.55,
      tmx = 0.5,
      tmy = 0.55,
      press = 0,
      tpress = 0;
    const onMove = (e: PointerEvent): void => {
      tmx = e.clientX / window.innerWidth;
      tmy = 1.0 - e.clientY / window.innerHeight;
      tpress = 1.0;
    };
    window.addEventListener('pointermove', onMove, { passive: true });
    window.addEventListener('pointerdown', onMove, { passive: true });
    window.addEventListener('pointerleave', () => {
      tpress = 0;
    });

    let dpr = 1;
    const resize = (): void => {
      dpr = Math.min(window.devicePixelRatio || 1, 1.5); // cap for fill-rate
      canvas.width = Math.max(1, Math.round(window.innerWidth * dpr));
      canvas.height = Math.max(1, Math.round(window.innerHeight * dpr));
      gl.viewport(0, 0, canvas.width, canvas.height);
    };
    window.addEventListener('resize', resize, { passive: true });
    resize();

    // --- loop: runs while the tab is visible; pauses when hidden ----------
    const start = performance.now();
    let intro = 0;
    let calm = 0;
    let running = false;
    const loop = (): void => {
      if (running) return;
      running = true;
      const frame = (now: number): void => {
        if (document.hidden) {
          running = false; // visibilitychange restarts us
          return;
        }
        const t = (now - start) / 1000;
        intro = Math.min(1, intro + 0.02);
        mx += (tmx - mx) * 0.06;
        my += (tmy - my) * 0.06;
        press += (tpress - press) * 0.05;
        // burst decays to ~0 in about 1.2s at 60fps (0.92^72 ≈ 0.002)
        burst *= 0.92;
        if (burst < 0.002) burst = 0;
        // calm: 0 at top -> 1 one viewport down, eased toward the target
        const calmT = Math.min(1, window.scrollY / window.innerHeight);
        calm += (calmT - calm) * 0.08;
        gl.uniform1f(u.time, t);
        gl.uniform2f(u.res, canvas.width, canvas.height);
        gl.uniform2f(u.mouse, mx, my);
        gl.uniform1f(u.intro, intro);
        gl.uniform1f(u.press, press);
        gl.uniform1f(u.calm, calm);
        gl.uniform1f(u.burst, burst);
        gl.uniform2f(u.burstO, bx, by);
        gl.drawArrays(gl.TRIANGLES, 0, 3);
        requestAnimationFrame(frame);
      };
      requestAnimationFrame(frame);
    };
    document.addEventListener('visibilitychange', () => {
      if (!document.hidden) loop();
    });
    loop();
  }
</script>

<style is:global>
  /* is:global because the canvas is created at runtime (no Astro scope attr).
     Hidden until live; fades in once the first frames are drawing. Same layer
     as the grid (z 0), under #main (z 1) and the CRT pass (z 5). */
  .flux-shader {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    pointer-events: none;
    z-index: 0;
    opacity: 0;
  }

  .flux-shader.is-live {
    opacity: 1;
    transition: opacity 600ms var(--ease-out);
  }
</style>
