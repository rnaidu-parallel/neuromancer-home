---
import Base from '../layouts/Base.astro';
import stats from '../data/stats.json';

const t = stats.totals;

const full = (n: number) => n.toLocaleString('en-US');
const compact = (n: number) => {
  const a = Math.abs(n);
  if (a >= 1e9) return (n / 1e9).toFixed(2).replace(/\.?0+$/, '') + 'B';
  if (a >= 1e6) return (n / 1e6).toFixed(1).replace(/\.0$/, '') + 'M';
  if (a >= 1e3) return (n / 1e3).toFixed(1).replace(/\.0$/, '') + 'K';
  return String(Math.round(n));
};
const usd = (n: number) => '$' + Math.round(n).toLocaleString('en-US');
const pretty = (d: string) =>
  new Date(d + 'T00:00:00Z').toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });

// server-side 7d / 30d rollups
const lastMs = new Date(stats.range.to + 'T00:00:00Z').getTime();
const sumLast = (days: number) => {
  const cut = lastMs - (days - 1) * 86400000;
  return stats.daily.filter((d) => new Date(d.date + 'T00:00:00Z').getTime() >= cut).reduce((s, d) => s + d.total, 0);
};
const t7 = sumLast(7);
const t30 = sumLast(30);
const avgPerDay = Math.round(t.total / stats.range.activeDays);

const topModels = stats.byModel.slice(0, 10);
const restModels = stats.byModel.slice(10);
const restTokens = restModels.reduce((s, m) => s + m.total, 0);
const maxShare = stats.byModel[0]?.share || 100;

// tool icons (simple brand-colored glyphs) + display meta
const icons: Record<string, string> = {
  claude: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><path d="M12 3v18M3 12h18M5.6 5.6l12.8 12.8M18.4 5.6 5.6 18.4"/></svg>',
  codex: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"><path d="M12 3l7.8 4.5v9L12 21l-7.8-4.5v-9L12 3z"/></svg>',
  cursor: '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M5 3l14.5 7.2-6.1 1.7-1.7 6.1z"/></svg>',
  opencode: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M9.5 8 5 12l4.5 4M14.5 8l4.5 4-4.5 4"/></svg>',
  gemini: '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2c.45 5.4 4.6 9.55 10 10-5.4.45-9.55 4.6-10 10-.45-5.4-4.6-9.55-10-10 5.4-.45 9.55-4.6 10-10z"/></svg>',
};
const toolMeta: Record<string, { name: string; c: string }> = {
  claude: { name: 'Claude', c: 'var(--t-claude)' },
  codex: { name: 'Codex', c: 'var(--t-codex)' },
  cursor: { name: 'Cursor', c: 'var(--t-cursor)' },
  opencode: { name: 'opencode', c: 'var(--t-opencode)' },
  gemini: { name: 'Gemini', c: 'var(--t-gemini)' },
};

const title = `AI coding-agent usage — ${compact(t.total)} tokens · Rahul Naidu`;
const description =
  `${compact(t.total)} tokens across ${stats.range.activeDays} active days, ${stats.byModel.length} models and ${stats.byTool.length} tools. Live usage stats from my AI coding agents (Claude Code, Codex, Cursor, opencode, Gemini).`;
---

<Base title={title} description={description}>
  <main id="main" class="wrap">
    <!-- identity (minimal) -->
    <header class="top">
      <div>
        <h1 class="top__name">Rahul Naidu Siriporam</h1>
        <p class="top__role">AI coding-agent usage</p>
      </div>
      <span class="top__upd label">updated {pretty(stats.generatedAt)}</span>
    </header>

    <!-- HERO: total + cost -->
    <section class="hero">
      <p class="label">Total tokens</p>
      <div class="hero__num num" data-count={t.total}>{full(t.total)}</div>
      <p class="hero__cost num">{usd(t.estValueUsd)}<span> value</span></p>
      <ul class="tiles" role="list">
        <li class="tile"><span class="tile__v num">{compact(t7)}</span><span class="tile__k">7 days</span></li>
        <li class="tile"><span class="tile__v num">{compact(t30)}</span><span class="tile__k">30 days</span></li>
        <li class="tile"><span class="tile__v num">{compact(avgPerDay)}</span><span class="tile__k">avg / day</span></li>
        <li class="tile"><span class="tile__v num">{compact(t.conversations)}</span><span class="tile__k">conversations</span></li>
        <li class="tile"><span class="tile__v num">{t.cachePct}%</span><span class="tile__k">cached</span></li>
        <li class="tile"><span class="tile__v num">{stats.range.activeDays}</span><span class="tile__k">active days</span></li>
      </ul>
    </section>

    <!-- ACTIVITY HEATMAP — centerpiece -->
    <section class="sec sec--heat" aria-labelledby="h-activity">
      <div class="sec__head">
        <h2 id="h-activity">Activity</h2>
        <span class="label">{pretty(stats.range.from)} — {pretty(stats.range.to)}</span>
      </div>
      <div class="heat">
        <div class="heat__scroll">
          <div class="heat__months num" id="heat-months"></div>
          <div class="heat__body">
            <div class="heat__days"><span>Mon</span><span>Wed</span><span>Fri</span></div>
            <div class="heat__grid" id="heat-grid"></div>
          </div>
        </div>
        <div class="heat__legend label">
          <span>Less</span>
          <i class="heat__k" data-l="0"></i><i class="heat__k" data-l="1"></i>
          <i class="heat__k" data-l="2"></i><i class="heat__k" data-l="3"></i><i class="heat__k" data-l="4"></i>
          <span>More</span>
        </div>
      </div>
    </section>

    <!-- TOOLS -->
    <section class="sec" aria-labelledby="h-tools">
      <div class="sec__head"><h2 id="h-tools">Tools</h2></div>
      <div class="toolbar" role="img" aria-label="Share of tokens by tool">
        {stats.byTool.map((tool) => (
          <span class="toolbar__seg" style={`--w:${tool.share}%; background:${toolMeta[tool.source]?.c || 'var(--muted)'}`}></span>
        ))}
      </div>
      <div class="toolcards">
        {stats.byTool.map((tool) => (
          <div class="toolcard">
            <span class="toolcard__ico" style={`color:${toolMeta[tool.source]?.c || 'var(--muted)'}`} set:html={icons[tool.source] || ''} />
            <span class="toolcard__name">{toolMeta[tool.source]?.name || tool.source}</span>
            <span class="toolcard__pct num">{tool.share}%</span>
            <span class="toolcard__meta">{tool.models} {tool.models === 1 ? 'model' : 'models'} · {compact(tool.total)}</span>
          </div>
        ))}
      </div>
    </section>

    <!-- MODELS -->
    <section class="sec" aria-labelledby="h-models">
      <div class="sec__head"><h2 id="h-models">Models</h2><span class="label">{stats.byModel.length} total</span></div>
      <ol class="models" role="list">
        {topModels.map((m, i) => (
          <li class="model">
            <span class="model__rank num">{i + 1}</span>
            <span class="model__name">{m.model}</span>
            <span class="model__bar"><span class="model__fill" style={`--w:${(m.share / maxShare) * 100}%`}></span></span>
            <span class="model__tok num">{compact(m.total)}</span>
            <span class="model__pct num">{m.share}%</span>
          </li>
        ))}
      </ol>
      {restModels.length > 0 && (
        <details class="more">
          <summary>{restModels.length} more · {compact(restTokens)} tokens</summary>
          <ol class="models" role="list">
            {restModels.map((m, i) => (
              <li class="model">
                <span class="model__rank num">{i + 11}</span>
                <span class="model__name">{m.model}</span>
                <span class="model__bar"><span class="model__fill" style={`--w:${(m.share / maxShare) * 100}%`}></span></span>
                <span class="model__tok num">{compact(m.total)}</span>
                <span class="model__pct num">{m.share}%</span>
              </li>
            ))}
          </ol>
        </details>
      )}
    </section>

    <!-- USAGE TREND (range switch) -->
    <section class="sec" aria-labelledby="h-trend">
      <div class="sec__head">
        <h2 id="h-trend">Usage</h2>
        <div class="tabs" role="tablist" aria-label="Time range">
          <button class="tab" role="tab" data-range="7" aria-selected="false" tabindex="-1">7D</button>
          <button class="tab" role="tab" data-range="30" aria-selected="true" tabindex="0">30D</button>
          <button class="tab" role="tab" data-range="90" aria-selected="false" tabindex="-1">90D</button>
          <button class="tab" role="tab" data-range="all" aria-selected="false" tabindex="-1">All</button>
        </div>
      </div>
      <div class="trend">
        <div class="trend__bars" id="trend-bars" role="img" aria-label="Daily tokens for the selected range"></div>
        <div class="trend__axis label"><span id="trend-from"></span><span id="trend-peak"></span><span id="trend-to"></span></div>
      </div>
    </section>

    <!-- DAILY BREAKDOWN -->
    <section class="sec" aria-labelledby="h-daily">
      <div class="sec__head"><h2 id="h-daily">Daily breakdown</h2></div>
      <div class="table__scroll">
        <table class="table num">
          <thead>
            <tr><th class="l">Date</th><th>Total</th><th>Input</th><th>Output</th><th>Cached</th><th>Reasoning</th><th>Convs</th></tr>
          </thead>
          <tbody id="table-body"></tbody>
        </table>
      </div>
      <button class="more__btn" id="table-more" hidden>Show all</button>
    </section>

    <footer class="foot">
      <nav class="foot__links" aria-label="Contact and profiles">
        <a href="https://github.com/rnaidu-parallel" rel="me">GitHub</a>
        <a href="https://www.linkedin.com/in/rahul-naidu-siriporam-15472116b" rel="me">LinkedIn</a>
        <a href="https://x.com/rahulwlw" rel="me" aria-label="Rahul on X (Twitter)">X</a>
        <a href="https://blog.neuromancer.in">Blog</a>
      </nav>
      <p class="foot__note label">Aggregate token counts from local agent logs — counts and dates only, no prompts or project data. Value estimated from published per-model pricing. Snapshot {pretty(stats.generatedAt)}.</p>
    </footer>
  </main>

  <script type="application/json" id="bb-data" set:html={JSON.stringify({ daily: stats.daily })} />
  <script>
    import '../scripts/telemetry.ts';
  </script>

  <style is:global>
    /* ---- top / identity ---- */
    .top { display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; padding: clamp(1.5rem, 4vw, 2.5rem) 0 clamp(1.75rem, 4vw, 2.75rem); border-bottom: 1px solid var(--line-2); }
    .top__name { font-size: var(--fs-sm); font-weight: 600; color: var(--bright); letter-spacing: 0; }
    .top__role { font-size: var(--fs-xs); color: var(--muted); margin-top: 0.15rem; }
    .top__upd { white-space: nowrap; padding-top: 0.2rem; }
    @media (max-width: 480px) { .top__upd { display: none; } }

    /* ---- hero ---- */
    .hero { padding: clamp(2rem, 6vw, 4rem) 0 clamp(1.5rem, 4vw, 2.5rem); text-align: center; }
    .hero .label { display: block; }
    .hero__num { font-size: var(--fs-mega); font-weight: 700; color: var(--bright); line-height: 1; margin: 0.6rem 0 0.4rem; }
    .hero__cost { font-size: clamp(1.1rem, 2.5vw, 1.5rem); font-weight: 600; color: var(--green); }
    .hero__cost span { color: var(--faint); font-weight: 500; font-size: 0.72em; margin-left: 0.3rem; }

    .tiles { list-style: none; padding: 0; margin: clamp(1.75rem, 4vw, 2.75rem) auto 0; display: grid; grid-template-columns: repeat(6, 1fr); gap: 0.6rem; max-width: 60rem; }
    .tile { background: var(--panel); border: 1px solid var(--line); border-radius: var(--radius-sm); padding: clamp(0.7rem, 1.6vw, 1.1rem) 0.5rem; display: flex; flex-direction: column; gap: 0.25rem; }
    .tile__v { font-size: var(--fs-tile); font-weight: 700; color: var(--bright); }
    .tile__k { font-size: var(--fs-micro); color: var(--muted); text-transform: uppercase; letter-spacing: 0.04em; }
    @media (max-width: 720px) { .tiles { grid-template-columns: repeat(3, 1fr); } }
    @media (max-width: 400px) { .tiles { grid-template-columns: repeat(2, 1fr); } }

    /* ---- section shell ---- */
    .sec { padding: clamp(1.75rem, 4vw, 2.75rem) 0; border-top: 1px solid var(--line-2); }
    .sec__head { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; margin-bottom: clamp(1rem, 2.5vw, 1.5rem); }
    .sec__head h2 { font-size: var(--fs-h1); }

    /* ---- heatmap (centerpiece) ---- */
    .sec--heat { padding-top: clamp(2rem, 5vw, 3.25rem); }
    .heat { background: var(--panel); border: 1px solid var(--line); border-radius: var(--radius); padding: clamp(1rem, 3vw, 1.75rem); }
    .heat__scroll { overflow-x: auto; -webkit-overflow-scrolling: touch; }
    .heat__months { display: flex; margin-left: 34px; height: 15px; position: relative; color: var(--muted); font-size: var(--fs-micro); }
    .heat__months span { position: absolute; }
    .heat__body { display: flex; gap: 7px; margin-top: 3px; width: max-content; }
    .heat__days { display: flex; flex-direction: column; justify-content: space-between; width: 27px; font-size: 10px; color: var(--faint); padding: 15px 0 3px; }
    .heat__grid { display: grid; grid-auto-flow: column; grid-template-rows: repeat(7, 15px); grid-auto-columns: 15px; gap: 4px; }
    .heat__cell { width: 15px; height: 15px; border-radius: 3px; background: var(--h0); }
    .heat__cell[data-l='0'] { background: var(--h0); }
    .heat__cell[data-l='1'] { background: var(--h1); }
    .heat__cell[data-l='2'] { background: var(--h2); }
    .heat__cell[data-l='3'] { background: var(--h3); }
    .heat__cell[data-l='4'] { background: var(--h4); }
    .heat__cell[data-empty='true'] { background: transparent; }
    .heat__legend { display: flex; align-items: center; gap: 4px; justify-content: flex-end; margin-top: 1rem; }
    .heat__k { width: 13px; height: 13px; border-radius: 3px; display: inline-block; }
    .heat__k[data-l='0'] { background: var(--h0); } .heat__k[data-l='1'] { background: var(--h1); }
    .heat__k[data-l='2'] { background: var(--h2); } .heat__k[data-l='3'] { background: var(--h3); }
    .heat__k[data-l='4'] { background: var(--h4); }

    /* ---- tools ---- */
    .toolbar { display: flex; height: 8px; border-radius: 5px; overflow: hidden; gap: 2px; margin-bottom: 1.25rem; }
    .toolbar__seg { width: var(--w); min-width: 3px; }
    .toolcards { display: grid; grid-template-columns: repeat(5, 1fr); gap: 0.6rem; }
    .toolcard { background: var(--panel); border: 1px solid var(--line); border-radius: var(--radius-sm); padding: clamp(0.8rem, 2vw, 1.15rem); display: grid; grid-template-columns: auto 1fr; grid-template-areas: 'ico name' 'ico pct' 'meta meta'; column-gap: 0.6rem; row-gap: 0.15rem; align-items: center; }
    .toolcard__ico { grid-area: ico; width: 26px; height: 26px; align-self: start; }
    .toolcard__ico svg { width: 100%; height: 100%; }
    .toolcard__name { grid-area: name; font-size: var(--fs-sm); font-weight: 600; color: var(--bright); }
    .toolcard__pct { grid-area: pct; font-size: 1.35rem; font-weight: 700; color: var(--bright); line-height: 1; }
    .toolcard__meta { grid-area: meta; font-size: var(--fs-micro); color: var(--muted); margin-top: 0.4rem; }
    @media (max-width: 820px) { .toolcards { grid-template-columns: repeat(3, 1fr); } }
    @media (max-width: 480px) { .toolcards { grid-template-columns: repeat(2, 1fr); } }

    /* ---- models ---- */
    .models { list-style: none; padding: 0; }
    .model { display: grid; grid-template-columns: 1.6rem minmax(8ch, 1.3fr) 3fr auto auto; align-items: center; gap: clamp(0.5rem, 1.5vw, 1rem); padding: 0.55rem 0; border-bottom: 1px solid var(--line-2); }
    .model__rank { font-size: var(--fs-xs); color: var(--faint); }
    .model__name { font-size: var(--fs-sm); color: var(--bright); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .model__bar { height: 7px; background: var(--line-2); border-radius: 4px; overflow: hidden; }
    .model__fill { display: block; height: 100%; width: var(--w); background: linear-gradient(90deg, #2a2f37, #6b7482); border-radius: 4px; }
    .model__tok { font-size: var(--fs-xs); color: var(--text); text-align: right; min-width: 5ch; }
    .model__pct { font-size: var(--fs-xs); color: var(--muted); text-align: right; min-width: 4ch; }
    @media (max-width: 620px) {
      .model { grid-template-columns: 1.4rem 1fr auto; grid-template-areas: 'r n p' 'r b b'; row-gap: 0.3rem; }
      .model__rank { grid-area: r; } .model__name { grid-area: n; } .model__pct { grid-area: p; } .model__bar { grid-area: b; } .model__tok { display: none; }
    }
    .more { margin-top: 0.9rem; }
    .more summary { font-size: var(--fs-xs); color: var(--muted); cursor: pointer; padding: 0.4rem 0; list-style: none; }
    .more summary::-webkit-details-marker { display: none; }
    .more summary::before { content: '+ '; color: var(--green); }
    .more[open] summary::before { content: '− '; }

    /* ---- trend ---- */
    .tabs { display: inline-flex; gap: 2px; padding: 3px; background: var(--panel); border: 1px solid var(--line); border-radius: 9px; }
    .tab { font-size: var(--fs-xs); font-weight: 500; color: var(--muted); padding: 0.35rem 0.75rem; border-radius: 6px; transition: all var(--dur-1); }
    .tab:hover { color: var(--text); }
    .tab[aria-selected='true'] { background: var(--green-2); color: #04130a; }
    .trend { background: var(--panel); border: 1px solid var(--line); border-radius: var(--radius); padding: clamp(1rem, 2.5vw, 1.5rem); }
    .trend__bars { display: flex; align-items: flex-end; gap: 2px; height: clamp(110px, 20vw, 180px); }
    .trend__bar { flex: 1 1 0; min-width: 0; background: var(--green-2); border-radius: 2px 2px 0 0; min-height: 2px; height: var(--h); position: relative; transition: filter var(--dur-1); }
    .trend__bar:hover { filter: brightness(1.35); }
    .trend__bar[data-peak='true'] { background: var(--h4); }
    .trend__bar::after { content: attr(data-tip); position: absolute; bottom: 100%; left: 50%; transform: translateX(-50%) translateY(-6px); background: var(--panel-2); border: 1px solid var(--line); color: var(--bright); font-size: var(--fs-micro); white-space: nowrap; padding: 0.25rem 0.5rem; border-radius: 5px; opacity: 0; pointer-events: none; transition: opacity var(--dur-1); z-index: 5; }
    .trend__bar:hover::after { opacity: 1; }
    .trend__axis { display: flex; justify-content: space-between; margin-top: 0.7rem; }

    /* ---- table ---- */
    .table__scroll { overflow-x: auto; border: 1px solid var(--line); border-radius: var(--radius); background: var(--panel); }
    .table { width: 100%; border-collapse: collapse; font-size: var(--fs-xs); min-width: 560px; }
    .table th { text-align: right; padding: 0.7rem 1rem; color: var(--muted); font-weight: 500; font-size: var(--fs-micro); text-transform: uppercase; letter-spacing: 0.05em; border-bottom: 1px solid var(--line); }
    .table th.l, .table td.l { text-align: left; }
    .table td { text-align: right; padding: 0.55rem 1rem; color: var(--text); border-bottom: 1px solid var(--line-2); }
    .table tr:hover td { background: var(--panel-2); }
    .table td.l { color: var(--bright); }
    .table .cache { color: var(--green); }
    .more__btn { display: block; margin: 1rem auto 0; color: var(--green); font-size: var(--fs-xs); padding: 0.55rem 1.2rem; border: 1px solid var(--line); border-radius: 8px; background: var(--panel); }
    .more__btn:hover { background: var(--panel-2); }

    /* ---- footer ---- */
    .foot { padding: clamp(2.5rem, 6vw, 4rem) 0 clamp(1.75rem, 4vw, 2.5rem); border-top: 1px solid var(--line); }
    .foot__links { display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; }
    .foot__links a { font-size: var(--fs-sm); color: var(--text); border-bottom: 1px solid transparent; padding-bottom: 2px; transition: all var(--dur-1); }
    .foot__links a:hover { color: var(--green); border-color: var(--green); }
    .foot__note { margin-top: 1.25rem; max-width: 60ch; line-height: 1.6; text-transform: none; letter-spacing: 0; }
  </style>
</Base>
