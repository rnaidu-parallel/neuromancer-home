---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Span from '../components/Span.astro';
import SpanNav from '../components/SpanNav.astro';
import ToolCall from '../components/ToolCall.astro';
import Experience from '../components/Experience.astro';
import MemoryRecall from '../components/MemoryRecall.astro';
import EvalBoard from '../components/EvalBoard.astro';
import { projects } from '../data/projects';

const title = 'Rahul Naidu Siriporam — agentic AI engineer';
const description =
  'Founding engineer building agentic AI systems. This page is an agent run: scroll to trace the answer to "who is rahul?".';

// 01 · plan — the run's checklist. Each row links to the span it resolves.
const plan = [
  { fn: 'get_projects()', desc: 'what he ships when nobody assigns it', to: 'projects', n: '02' },
  { fn: 'get_experience()', desc: 'what he has shipped in production', to: 'experience', n: '03' },
  { fn: 'recall("writing")', desc: 'how he thinks, in his own words', to: 'writing', n: '04' },
  { fn: 'eval()', desc: 'check the claims against the numbers', to: 'eval', n: '05' },
  { fn: 'synthesize()', desc: 'final answer + how to reach him', to: 'answer', n: '06' },
];

// 02 · get_projects() — terminals with desktop pin+swap (see scripts/projects.ts).
//      Data lives in src/data/projects.ts.

// 03 · get_experience() — structured log blocks (see components/Experience.astro).
// 04 · recall("writing") — build-time RSS + fallback (see components/MemoryRecall.astro).
// 05 · eval scoreboard — checked numbers (see components/EvalBoard.astro).

const contacts = [
  { label: 'schedule a call', href: 'https://calendar.app.google/6ukMiHNSgbPLC5YA7' },
  { label: 'github', href: 'https://github.com/rnaidu-parallel' },
  { label: 'linkedin', href: 'https://www.linkedin.com/in/rahul-naidu-siriporam-15472116b' },
  { label: 'x', href: 'https://x.com/rahulwlw' },
  { label: 'blog', href: 'https://blog.neuromancer.in' },
  { label: 'resume', href: 'https://blog.neuromancer.in/resume.pdf' },
];
---

<Base title={title} description={description}>
  <main id="main" class="container">
    <Hero />

    <Span id="plan" index="01" kind="plan">
      <p class="lede">
        The query names a person. Resolve who he is, what he builds, and whether he’s
        worth a conversation.
      </p>

      <ul class="plan mono">
        {
          plan.map((row) => (
            <li>
              <span class="pk" aria-hidden="true">
                [x]
              </span>
              <span class="fn">{row.fn}</span>
              <span class="desc">{row.desc}</span>
              <a class="goto" href={`#${row.to}`}>
                → {row.n}
              </a>
            </li>
          ))
        }
      </ul>
    </Span>

    <Span id="projects" index="02" kind="tool_call: get_projects()" branch>
      <p class="projects-intro">
        Four things he built and published because the problem was interesting.
      </p>

      <div class="projects-stage" data-projects-stage>
        {projects.map((p) => <ToolCall project={p} />)}
        <p class="projects-progress mono" data-projects-progress aria-hidden="true">
          [1/4]
        </p>
      </div>
    </Span>

    <Span id="experience" index="03" kind="tool_call: get_experience()" branch>
      <Experience />
    </Span>

    <Span id="writing" index="04" kind='memory: recall("writing")'>
      <MemoryRecall />
    </Span>

    <Span id="eval" index="05" kind="eval: scoreboard">
      <EvalBoard />
    </Span>

    <Span id="answer" index="06" kind="answer" terminal>
      <p class="answer-text">
        Founding engineer who has spent four years shipping agentic AI systems to
        production, and publishes the sharp edges he finds along the way. Worth the
        conversation.
      </p>

      <p class="contacts mono">
        {
          contacts.map((c, i) => (
            <>
              {i > 0 && <span class="sep" aria-hidden="true"> · </span>}
              <a href={c.href}>{c.label}</a>
            </>
          ))
        }
      </p>
      <p class="stack-line dim-note mono">(mcp easter egg lands in phase 5)</p>
    </Span>

    <footer class="run-footer">
      <div aria-hidden="true"></div>
      <p class="mono">[run pending] · spans: 6</p>
    </footer>
  </main>

  <SpanNav />

  <script>
    // Page-specific boot orchestration. motion.ts (global, loaded in Base) owns
    // the matchMedia branch; boot.ts + thread.ts register into it via onMotionReady.
    import '../scripts/boot.ts';
    import '../scripts/thread.ts';
    // Imported AFTER thread.ts so the pin trigger is created after the thread's
    // draw triggers; projects.ts calls ScrollTrigger.refresh() to re-sort them.
    import '../scripts/projects.ts';
  </script>
</Base>

<style>
  .lede {
    color: var(--c-text);
    font-size: var(--fs-h3);
    line-height: 1.4;
  }

  /* 01 · plan checklist — mono grid rows */
  .plan {
    list-style: none;
    padding: 0;
    margin-top: var(--sp-6);
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
  }
  .plan li {
    display: grid;
    grid-template-columns: auto auto 1fr auto;
    gap: var(--sp-3);
    align-items: baseline;
    font-size: var(--fs-micro);
  }
  .plan .pk {
    color: var(--c-ok);
  }
  .plan .fn {
    color: var(--c-bright);
  }
  .plan .desc {
    color: var(--c-text);
  }
  .plan .goto {
    color: var(--c-cyan);
    text-decoration: none;
    white-space: nowrap;
  }
  .plan .goto:hover {
    color: var(--c-bright);
  }

  /* 02 · get_projects() — intro + card stack */
  .projects-intro {
    color: var(--c-text);
    font-size: var(--fs-body);
    line-height: 1.5;
    margin-bottom: var(--sp-12);
  }

  /* Default (no-JS / reduced / mobile): plain readable vertical stack. The
     absolute-stacking + progress readout live behind .is-pinned-stage, which
     projects.ts adds only for desktop + motion. */
  .projects-stage {
    display: flex;
    flex-direction: column;
    gap: var(--sp-16);
  }

  .projects-progress {
    display: none; /* diegetic pin-only UI; shown by .is-pinned-stage */
    color: var(--c-cyan);
  }

  .projects-stage.is-pinned-stage {
    display: block;
    position: relative;
  }

  .projects-stage.is-pinned-stage .projects-progress {
    display: block;
    position: absolute;
    top: 0;
    right: 0;
    z-index: 2;
    opacity: 0.75;
  }

  /* 06 · answer — dim-note/stack-line carry the phase-5 placeholder line */
  .stack-line {
    color: var(--c-text);
    margin-top: var(--sp-1);
  }
  .dim-note {
    color: var(--c-text);
    opacity: 0.7;
  }

  /* 06 · answer */
  .answer-text {
    font-size: var(--fs-h3);
    line-height: 1.45;
    color: var(--c-bright);
  }
  .contacts {
    margin-top: var(--sp-6);
    font-size: var(--fs-micro);
    line-height: 2;
  }
  .contacts .sep {
    color: var(--c-dim);
  }

  /* Footer mirrors the span grid (empty rail column) so its text aligns with
     span content. The thread terminates at the answer span — no rail here. */
  .run-footer {
    display: grid;
    grid-template-columns: var(--rail) minmax(0, 1fr);
    column-gap: var(--sp-2);
    padding-block: var(--sp-16) var(--sp-24);
    color: var(--c-text);
  }

  @media (max-width: 767px) {
    .run-footer {
      grid-template-columns: var(--rail-m) minmax(0, 1fr);
    }
  }
</style>
