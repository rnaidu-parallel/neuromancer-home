---
import Base from '../layouts/Base.astro';

const title = 'Rahul Naidu Siriporam — agentic AI engineer';
const description =
  'Founding engineer building agentic AI systems. This page is an agent run: scroll to trace the answer to "who is rahul?".';

const spans = [
  { id: 'plan', label: '01 · plan', heading: 'plan' },
  { id: 'projects', label: '02 · tool_call', heading: 'tool_call: get_projects()' },
  { id: 'experience', label: '03 · tool_call', heading: 'tool_call: get_experience()' },
  { id: 'writing', label: '04 · memory', heading: 'memory: recall("writing")' },
  { id: 'eval', label: '05 · eval', heading: 'eval: scoreboard' },
  { id: 'answer', label: '06 · answer', heading: 'answer' },
];
---

<Base title={title} description={description}>
  <main id="main" class="container">
    <header id="boot">
      <p class="mono">$ query "who is rahul?"</p>
      <h1>Rahul Naidu Siriporam</h1>
      <p>Founding engineer, building agentic AI systems.</p>
      <p class="mono">[status] run started · 6 spans queued</p>
    </header>

    {
      spans.map((span, i) => (
        <section id={span.id} aria-labelledby={`${span.id}-h`}>
          <p class="mono">{span.label}</p>
          <h2 id={`${span.id}-h`}>{span.heading}</h2>
          <p>Section content lands in phase {i + 1}.</p>
        </section>
      ))
    }

    <footer>
      <p class="mono">[run pending] · spans: 6</p>
    </footer>
  </main>
</Base>
